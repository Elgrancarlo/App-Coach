# ============================================================================
# Coach AI - Production Environment Template
# Copy this file and configure the variables below for Railway deployment
# ============================================================================

# ---------------------------
# Debug/logs (set to false in production)
# ---------------------------
DEBUG_LOGS=false
DEBUG_AGENT_LOGS=false

# ---------------------------
# Database (Railway will provide this automatically)
# ---------------------------
DATABASE_URL=postgresql://user:password@host:port/database

# ---------------------------
# CORS (configure for your frontend domain)
# ---------------------------
ALLOW_ORIGINS=https://your-frontend-domain.com
ALLOW_CREDENTIALS=true

# ---------------------------
# Authentication (REQUIRED - generate secure values)
# ---------------------------
ACCESS_KEY=flynow
ACCESS_KEY_HASH=your-bcrypt-hash-here
AUTH_SECRET=your-64-character-secret-here
AUTH_TOKEN_TTL_SECONDS=3600
# For tests (same value as ACCESS_KEY)
TEST_PASSKEY=flynow

# ---------------------------
# AI Models (default configuration)
# ---------------------------
DEFAULT_MODEL_NAME=google/gemini-2.5-flash
DEFAULT_USE_TAVILY=true

# Studio overrides (for LangGraph Studio)
STUDIO_MODEL_NAME=google/gemini-2.5-flash
STUDIO_USE_TAVILY=true

# ---------------------------
# External APIs (REQUIRED)
# ---------------------------
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TAVILY_API_KEY=your-tavily-api-key-here

# ---------------------------
# Observability (optional)
# ---------------------------
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=coach-ai-production
